<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ClipBoard.Mac</AssemblyName>
    <Version>2.1.0</Version>
    <RootNamespace>ClipBoard</RootNamespace>
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.19" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.19" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.Skottie" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="2.88.9" />
    <AvaloniaResource Include="Assets/menubar.png" />
    <Compile Include="../ClipBoard/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../ClipBoard/Services/AppSettings.cs;../ClipBoard/Services/FavoritesStore.cs;../ClipBoard/Services/PersistenceService.cs;../ClipBoard/Services/RichText.cs;../ClipBoard/Services/Sticker*.cs;../ClipBoard/Services/Telegram*.cs" Link="Services/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
