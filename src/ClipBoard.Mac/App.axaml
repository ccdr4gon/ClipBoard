<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClipBoard.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#F8F5EE" />
      <Setter Property="Foreground" Value="#2C2418" />
      <Setter Property="FontFamily" Value="PingFang SC, Segoe UI" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#F0E9DD" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="BorderBrush" Value="#7A4F2B" />
      <Setter Property="Foreground" Value="#7A4F2B" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#FDFAF3" />
    </Style>
  </Application.Styles>
</Application>
