<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ClipBoard.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Background" Value="#F8F5EE" />
      <Setter Property="Foreground" Value="#2C2418" />
      <Setter Property="FontFamily" Value="PingFang SC, Segoe UI" />
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="#F0E9DD" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="12,7" />
    </Style>
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="0,0,0,10" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="BorderBrush" Value="#7A4F2B" />
      <Setter Property="Foreground" Value="#7A4F2B" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="#FDFAF3" />
    </Style>
    <Style Selector="Button.caption, Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#857867" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.caption:pointerover, Button.quiet:pointerover">
      <Setter Property="Background" Value="#14000000" />
    </Style>
    <Style Selector="Button.caption">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#2C2418" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="TextBox.panelSearch">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontFamily" Value="Georgia, PingFang SC, Segoe UI" />
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBox.panelSearch:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="ClipToBounds" Value="False" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.history ListBoxItem">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="#242C2418" />
    </Style>
    <Style Selector="ListBox.history ListBoxItem:pointerover">
      <Setter Property="Background" Value="#0F7A4F2B" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#1F7A4F2B" />
    </Style>
    <Style Selector="ListBox.tiles ListBoxItem"><Setter Property="Margin" Value="10" /></Style>
    <Style Selector="ListBox.emoji ListBoxItem"><Setter Property="Margin" Value="2" /></Style>
  </Application.Styles>
</Application>
